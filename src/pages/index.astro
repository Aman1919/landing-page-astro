---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header.astro';
import Banner from '../components/banner.astro';
import Reviews from '../components/reviews.astro';
import Services from '../components/services.astro';
import Blog from '../components/blog.astro';
import GetInTouch from '../components/getintouch.astro';
import Footer from "../components/footer.astro"
import DISCLAIMER from "../components/popup.astro"
//import BannerImage from '../assests/banner1.png';
import Searchandwatch from '../components/searchandwatch.astro';
import Partners from '../components/partners.astro';
import NewYearBanner from '../assests/newyear2025.jpg';
import Image from 'astro/components/Image.astro';
---

<Layout title="Kieshva Intellect" >
<main>
	<Header/>
  <div class="relative w-full lg:h-screen  h-[70vh] overflow-hidden">
  <Image 
    src={NewYearBanner} 
    alt="Banner Image" 
    class="absolute inset-0 w-full h-full object-cover object-center lg:bg-cover lg:bg-center lg:bg-no-repeat lg:object-fill" 
  />
  </div>
<Services/>
<Reviews/>
<Blog/>
<Searchandwatch/>
<Partners/>
<GetInTouch/>
<Footer/>
</main>
<DISCLAIMER/>
</Layout>

<script is:inline>

window.onload = function() {
const disclaimer = document.getElementById('disclaimer');
if(!disclaimer)return;

  if (sessionStorage.getItem('acceptDisclaimer') === 'true') {
    disclaimer.style.display = 'none';
document.body.style.overflow = 'auto';
  }else{
    disclaimer.style.display = 'flex';
document.body.style.overflow = 'hidden';
}
document.getElementById('acceptButton')?.addEventListener('click', function() {
    sessionStorage.setItem('acceptDisclaimer', 'true');
    disclaimer.style.display = 'none';
document.body.style.overflow = 'auto';
  });
}

  
</script>
